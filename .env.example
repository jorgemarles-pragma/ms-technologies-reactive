# Copia este archivo como .env y ajusta los valores. Nunca subas .env al repositorio.

# --- Servidor ---
SERVER_PORT=8080

# --- Base de datos (PostgreSQL / R2DBC) ---
POSTGRES_DB=mstecnologias
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=changeme
SPRING_R2DBC_URL=r2dbc:postgresql://localhost:5432/mstecnologias
SQL_INIT_MODE=always

# --- Seguridad JWT ---
# Clave HS256 en Base64, minimo 256 bits. Genera una propia, no uses esta.
JWT_SECRET=cmVlbXBsYXphLWVzdGEtY2xhdmUtcG9yLXVuYS1yZWFsLWRlLTMyLWJ5dGVz

# --- Observabilidad ---
TRACING_SAMPLING=0.1

